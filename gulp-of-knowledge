function shuffle(arr) {
  const a = [...arr];
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

function updateScoreboard() {
  document.getElementById('total-score').textContent = state.totalScore;
  const done = Object.keys(state.chapterScores).length;
  document.getElementById('chapters-done').textContent = `${done}/6`;
  document.getElementById('streak').textContent = state.streak;
}

function buildChapterGrid() {
  const grid = document.getElementById('chapter-grid');
  grid.innerHTML = '';
  CHAPTERS.forEach((ch, i) => {
    const score = state.chapterScores[ch.id];
    const completed = score !== undefined;
    const div = document.createElement('div');
    div.className = 'chapter-card' + (completed ? ' completed' : '');
    div.onclick = () => startChapter(ch.id);
    div.innerHTML = `
      ${completed ? '<div class="chapter-badge">Done ✓</div>' : ''}
      <div class="chapter-num">0${i + 1}</div>
      <div class="chapter-flag">${ch.flag}</div>
      <div class="chapter-name">${ch.name}</div>
      <div class="chapter-desc">${ch.desc}</div>
      <div class="chapter-meta">
        <span class="chapter-count">${completed ? score + '/10 pts' : '10 Questions'}</span>
        <span class="chapter-arrow">→</span>
      </div>
    `;
    grid.appendChild(div);
  });
}

function startChapter(id) {
  state.currentChapter = id;
  state.currentQ = 0;
  state.answered = false;
  state.shuffledQuestions = shuffle(CHAPTERS[id].questions);

  document.getElementById('screen-home').style.display = 'none';
  document.getElementById('screen-quiz').style.display = 'block';
  document.getElementById('screen-results').style.display = 'none';

  const ch = CHAPTERS[id];
  document.getElementById('quiz-chapter-title').textContent = `${ch.flag} ${ch.name}`;
  renderQuestion();
}

function renderQuestion() {
  const ch = CHAPTERS[state.currentChapter];
  const q = state.shuffledQuestions[state.currentQ];
  const total = state.shuffledQuestions.length;

  document.getElementById('quiz-progress-text').textContent = `${state.currentQ + 1} of ${total}`;
  document.getElementById('progress-bar').style.width = `${(state.currentQ / total) * 100}%`;
  document.getElementById('question-kicker').textContent = `Question ${state.currentQ + 1}`;
  document.getElementById('question-text').textContent = q.q;
  document.getElementById('feedback-box').classList.remove('show');
  state.answered = false;

  const grid = document.getElementById('options-grid');
  grid.innerHTML = '';
  const labels = ['A', 'B', 'C', 'D'];
  q.opts.forEach((opt, i) => {
    const btn = document.createElement('button');
    btn.className = 'option-btn';
    btn.innerHTML = `<div class="option-label">${labels[i]}</div>${opt}`;
    btn.onclick = () => selectAnswer(i, btn);
    grid.appendChild(btn);
  });

  const isLast = state.currentQ === total - 1;
  document.getElementById('btn-next').textContent = isLast ? 'See Results →' : 'Next Question →';
}

let correctThisChapter = 0;

function selectAnswer(idx, btn) {
  if (state.answered) return;
  state.answered = true;

  const q = state.shuffledQuestions[state.currentQ];
  const btns = document.querySelectorAll('.option-btn');
  btns.forEach(b => b.disabled = true);

  if (idx === q.answer) {
    btn.classList.add('correct');
    state.totalScore += 10;
    state.streak++;
    correctThisChapter++;
    document.getElementById('feedback-result').textContent = '✓ Correct!';
    document.getElementById('feedback-result').className = 'feedback-result win';
  } else {
    btn.classList.add('wrong');
    btns[q.answer].classList.add('reveal');
    state.streak = 0;
    document.getElementById('feedback-result').textContent = '✗ Not quite.';
    document.getElementById('feedback-result').className = 'feedback-result lose';
  }

  document.getElementById('feedback-fact').textContent = q.fact;
  document.getElementById('feedback-box').classList.add('show');
  updateScoreboard();
}

function nextQuestion() {
  state.currentQ++;
  if (state.currentQ >= state.shuffledQuestions.length) {
    showResults();
  } else {
    renderQuestion();
  }
}

function showResults() {
  const total = state.shuffledQuestions.length;
  const pct = Math.round((correctThisChapter / total) * 100);
  const pts = correctThisChapter * 10;
  state.chapterScores[state.currentChapter] = correctThisChapter;

  document.getElementById('screen-quiz').style.display = 'none';
  document.getElementById('screen-results').style.display = 'block';

  const ch = CHAPTERS[state.currentChapter];
  document.getElementById('results-headline').innerHTML = `${ch.flag} ${ch.name} <em>Complete</em>`;
  document.getElementById('results-sub').textContent = `${correctThisChapter} of ${total} correct — ${pct}% accuracy`;
  document.getElementById('res-correct').textContent = `${correctThisChapter}/${total}`;
  document.getElementById('res-pct').textContent = `${pct}%`;
  document.getElementById('res-pts').textContent = `+${pts}`;

  let title, text;
  if (pct === 100) {
    title = 'Culinary Mastermind'; text = 'Perfect score. A flawless performance. You don\'t just eat this food — you understand it.';
  } else if (pct >= 80) {
    title = 'Seasoned Expert'; text = 'Strong work. Your knowledge is deep and your instincts are sharp. A chef would be impressed.';
  } else if (pct >= 60) {
    title = 'Skilled Apprentice'; text = 'Solid foundation. You know more than most — and now you know even more than you did.';
  } else if (pct >= 40) {
    title = 'Curious Diner'; text = 'You\'re at the table and asking good questions. Keep eating, keep reading, keep exploring.';
  } else {
    title = 'Fresh Palate'; text = 'Every expert started here. The knowledge is in these questions — go back and absorb every fact.';
  }

  document.getElementById('verdict-title').textContent = title;
  document.getElementById('verdict-text').textContent = text;

  correctThisChapter = 0;
  updateScoreboard();
  buildChapterGrid();
}

function retryChapter() {
  const id = state.currentChapter;
  delete state.chapterScores[id];
  correctThisChapter = 0;
  startChapter(id);
}

function goHome() {
  correctThisChapter = 0;
  document.getElementById('screen-home').style.display = 'block';
  document.getElementById('screen-quiz').style.display = 'none';
  document.getElementById('screen-results').style.display = 'none';
  buildChapterGrid();
}

// Init
buildChapterGrid();
updateScoreboard();
</script>
</body>
</html>
